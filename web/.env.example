# Copy to .env.local and fill in.
# Every VITE_ variable is baked into the client bundle at build time — none of
# these are secrets, and none of them should ever be.

# Supabase — Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Firebase web push — Project Settings -> General -> Your apps -> Web -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Project Settings -> Cloud Messaging -> Web Push certificates -> key pair
VITE_FIREBASE_VAPID_KEY=

# NEVER put the service_role key here. It bypasses row-level security and
# belongs only in the Edge Function's secrets.
